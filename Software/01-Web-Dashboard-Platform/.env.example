# Optional. Without this, the app runs exactly as before — the core fleet
# simulation uses its own synthetic weather model and needs no external API
# keys at all. Setting this only enables the "Live Corpus Christi Weather"
# card (on /deployment) and the "Use real weather" button (on /simulation).
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
