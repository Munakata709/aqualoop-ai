{
  "name": "aqualoop-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AquaLoop AI Raspberry Pi gateway: Modbus + MQTT ingestion, local decision engine, local HTTP API, and cloud sync.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
