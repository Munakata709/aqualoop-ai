DEVICE_ID=awg-001

# Modbus — PLC (and, by default, the energy meters sharing its transport)
MODBUS_PLC_HOST=192.168.1.10
MODBUS_PLC_PORT=502
MODBUS_PLC_UNIT_ID=1
# Set MODBUS_SERIAL_PATH instead of HOST/PORT to use RTU over a serial gateway, e.g. /dev/ttyUSB0
# MODBUS_SERIAL_PATH=/dev/ttyUSB0
# MODBUS_SERIAL_BAUD=9600

MODBUS_ENERGY_METER_1_UNIT_ID=2
MODBUS_ENERGY_METER_2_UNIT_ID=3

# MQTT (sensor telemetry from the ESP32-S3 node)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=aqualoop
MQTT_PASSWORD=change-me

POLL_INTERVAL_MS=5000
HEARTBEAT_STALE_AFTER_MS=30000

SQLITE_PATH=./data/aqualoop-gateway.db

HTTP_PORT=8080

# Cloud sync — leave blank to disable (gateway still runs fully locally)
# CLOUD_INGEST_URL=https://your-aqualoop-ai-deployment.example.com/api/telemetry/ingest
# CLOUD_INGEST_TOKEN=change-me
CLOUD_SYNC_INTERVAL_MS=30000

TANK_MIN_RESERVE_PCT=15
TANK_BUFFER_MULTIPLIER=1.5
